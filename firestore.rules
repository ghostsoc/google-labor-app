rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string && data.uid.size() <= 128
          && data.email is string && data.email.size() <= 256;
      }

      allow get, list: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Inventory Collection
    match /inventory/{itemId} {
      function isValidInventory(data) {
        return data.sku is string && data.sku.size() <= 64
          && data.name is string && data.name.size() <= 256
          && data.category is string && data.category.size() <= 64
          && data.totalQuantity is number && data.totalQuantity >= 0
          && data.availableQuantity is number && data.availableQuantity >= 0
          && data.dayRate is number && data.dayRate >= 0;
      }

      allow get, list: if true;
      allow create: if isValidId(itemId) && isValidInventory(incoming());
      allow update: if isValidId(itemId) && isValidInventory(incoming());
      allow delete: if isValidId(itemId);
    }

    // Staff Crew Members Collection
    match /staff/{staffId} {
      function isValidStaff(data) {
        return data.name is string && data.name.size() <= 128
          && data.role is string && data.role.size() <= 128
          && data.dayRate is number && data.dayRate >= 0
          && data.hourlyRate is number && data.hourlyRate >= 0;
      }

      allow get, list: if true;
      allow create: if isValidId(staffId) && isValidStaff(incoming());
      allow update: if isValidId(staffId) && isValidStaff(incoming());
      allow delete: if isValidId(staffId);
    }

    // Quotes & Booked Events Collection
    match /quotes/{quoteId} {
      function isValidQuote(data) {
        return data.quoteNumber is string && data.quoteNumber.size() <= 64
          && data.eventName is string && data.eventName.size() <= 256
          && data.venueName is string && data.venueName.size() <= 256
          && data.totalAmount is number && data.totalAmount >= 0
          && data.status is string && data.status.size() <= 32;
      }

      allow get, list: if true;
      allow create: if isValidId(quoteId) && isValidQuote(incoming());
      allow update: if isValidId(quoteId) && isValidQuote(incoming());
      allow delete: if isValidId(quoteId);
    }

    // Labor Shifts Collection
    match /shifts/{shiftId} {
      function isValidShift(data) {
        return data.eventName is string && data.eventName.size() <= 256
          && data.staffName is string && data.staffName.size() <= 128
          && data.role is string && data.role.size() <= 128
          && data.date is string && data.date.size() <= 64
          && data.startTime is string && data.startTime.size() <= 32
          && data.endTime is string && data.endTime.size() <= 32
          && data.rate is number && data.rate >= 0
          && data.hours is number && data.hours >= 0
          && data.status is string && data.status.size() <= 32;
      }

      allow get, list: if true;
      allow create: if isValidId(shiftId) && isValidShift(incoming());
      allow update: if isValidId(shiftId) && isValidShift(incoming());
      allow delete: if isValidId(shiftId);
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      function isValidInvoice(data) {
        return data.invoiceNumber is string && data.invoiceNumber.size() <= 64
          && data.eventName is string && data.eventName.size() <= 256
          && data.issueDate is string && data.issueDate.size() <= 64
          && data.dueDate is string && data.dueDate.size() <= 64
          && data.totalAmount is number && data.totalAmount >= 0
          && data.paidAmount is number && data.paidAmount >= 0
          && data.balanceDue is number
          && data.paymentStatus is string && data.paymentStatus.size() <= 32;
      }

      allow get, list: if true;
      allow create: if isValidId(invoiceId) && isValidInvoice(incoming());
      allow update: if isValidId(invoiceId) && isValidInvoice(incoming());
      allow delete: if isValidId(invoiceId);
    }

    // Clients Collection
    match /clients/{clientId} {
      function isValidClient(data) {
        return data.name is string && data.name.size() <= 128
          && data.email is string && data.email.size() <= 256
          && data.billingTerms is string && data.billingTerms.size() <= 64;
      }

      allow get, list: if true;
      allow create: if isValidId(clientId) && isValidClient(incoming());
      allow update: if isValidId(clientId) && isValidClient(incoming());
      allow delete: if isValidId(clientId);
    }

    // Maintenance Records Collection
    match /maintenance/{recordId} {
      function isValidMaintenance(data) {
        return data.inventoryItemId is string && data.inventoryItemId.size() <= 128
          && data.inventoryItemName is string && data.inventoryItemName.size() <= 256
          && data.sku is string && data.sku.size() <= 64
          && data.dateLogged is string && data.dateLogged.size() <= 64
          && data.type is string && data.type.size() <= 128
          && data.status is string && data.status.size() <= 64
          && data.issueDescription is string && data.issueDescription.size() <= 2048;
      }

      allow get, list: if true;
      allow create: if isValidId(recordId) && isValidMaintenance(incoming());
      allow update: if isValidId(recordId) && isValidMaintenance(incoming());
      allow delete: if isValidId(recordId);
    }

    // Settings Collection
    match /settings/{settingsId} {
      function isValidSettings(data) {
        return data.companyName is string && data.companyName.size() <= 128
          && data.defaultTaxRate is number
          && data.defaultDamageWaiver is number
          && data.currencySymbol is string && data.currencySymbol.size() <= 8;
      }

      allow get, list: if true;
      allow create: if isValidId(settingsId) && isValidSettings(incoming());
      allow update: if isValidId(settingsId) && isValidSettings(incoming());
      allow delete: if false;
    }

    // Connection Health Check document
    match /test/{testId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
